{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.box1.org/events/v1/notification.failed.schema.json",
  "title": "NotificationFailed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notificationId",
    "orderId",
    "noticeType",
    "channel",
    "templateVersion",
    "attemptCount",
    "provider",
    "failureCategory",
    "failureCode",
    "httpStatus",
    "failedAt"
  ],
  "properties": {
    "notificationId": {
      "type": "string",
      "pattern": "^ntf_[A-Za-z0-9_-]{1,64}$"
    },
    "orderId": {
      "type": "string",
      "pattern": "^ord_[A-Za-z0-9_-]+$"
    },
    "noticeType": {
      "type": "string",
      "enum": [
        "ORDER_SHIPPED",
        "SHIPMENT_DELAYED",
        "SHIPMENT_FAILED",
        "ORDER_EXCEPTION",
        "ORDER_REJECTED"
      ]
    },
    "channel": {
      "type": "string",
      "pattern": "^ops-[a-z0-9-]{1,40}$"
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^[A-Z][A-Z_]*@v[1-9][0-9]*$",
      "maxLength": 64
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "provider": {
      "type": "string",
      "enum": [
        "stub"
      ]
    },
    "failureCategory": {
      "type": "string",
      "enum": [
        "RETRIES_EXHAUSTED",
        "PERMANENT_REJECTION"
      ]
    },
    "failureCode": {
      "type": "string",
      "enum": [
        "PROVIDER_UNAVAILABLE",
        "PROVIDER_TIMEOUT",
        "PROVIDER_REJECTED",
        "PROVIDER_ERROR"
      ]
    },
    "httpStatus": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
