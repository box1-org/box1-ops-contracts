{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.box1.org/events/v1/site.stock-held.schema.json",
  "title": "SiteStockHeld payload v1",
  "description": "A site placed or released a hold on units of one SKU. In v1 a hold is recorded centrally for audit and does not change on hand or available stock. See SITE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteId", "holdId", "sku", "quantity", "action", "reasonCode", "changedAt"],
  "properties": {
    "siteId": { "type": "string", "pattern": "^site_[A-Za-z0-9_-]+$" },
    "holdId": { "type": "string", "pattern": "^hold_[A-Za-z0-9_-]{1,64}$" },
    "sku": { "type": "string", "minLength": 1, "maxLength": 80 },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "action": { "type": "string", "enum": ["PLACED", "RELEASED"] },
    "reasonCode": { "type": "string", "enum": ["DAMAGED", "QUALITY_CHECK", "COUNT_DISCREPANCY", "OTHER"] },
    "changedAt": { "type": "string", "format": "date-time" }
  }
}
