{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.box1.org/events/v1/inventory.rejected.schema.json",
  "title": "InventoryRejected payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "sku",
    "quantity",
    "siteId",
    "reasonCode"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^ord_[A-Za-z0-9_-]+$"
    },
    "sku": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "siteId": {
      "type": "string",
      "pattern": "^site_[A-Za-z0-9_-]+$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 64
    }
  }
}
